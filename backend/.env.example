DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Direct (non-pooled) connection — used by prisma migrate. Optional in dev.
DIRECT_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="your_super_secret_key_min_32_chars"
JWT_EXPIRES_IN="8h"
PORT=5000
NODE_ENV=development

# Seed admin (used by `npm run db:seed`) — never commit real values
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password
SEED_ADMIN_MOBILE=9000000000

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="ManpowerPay HMS <noreply@manpowerpay.com>"

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

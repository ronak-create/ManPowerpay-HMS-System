DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Direct (non-pooled) connection — used by prisma migrate. Optional in dev.
DIRECT_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="your_super_secret_key_min_32_chars"
JWT_EXPIRES_IN="8h"
PORT=5000
NODE_ENV=development

# PII encryption (Aadhaar/PAN/bank account). 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, PII encryption stays dormant (values stored as plaintext).
ENCRYPTION_KEY=

# Seed admin (used by `npm run db:seed`) — never commit real values
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password
SEED_ADMIN_MOBILE=9000000000

# Public demo tenant (used by `npm run db:seed:demo`). Intentionally a known login;
# keep it isolated by tenant scoping and never reuse a real admin account.
SEED_DEMO_EMAIL=demo@manpowerpay.com
SEED_DEMO_PASSWORD=Demo@12345

# Audit-log retention window in days for `npm run prune:audit` (default 365; 0 disables).
AUDIT_LOG_RETENTION_DAYS=365

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="ManpowerPay HMS <noreply@manpowerpay.com>"

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Error tracking (Sentry). Dormant if unset — no data is sent in dev/CI.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Razorpay billing. Key id is publishable (also returned to the browser at checkout);
# the secret and webhook secret are server-only — never expose them. If KEY_ID/SECRET
# are unset, billing checkout stays dormant (the plan grid shows a "contact support"
# notice instead of a live checkout). Webhook: point Razorpay at
# POST {API}/api/billing/webhook and paste the same secret you set in the dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# File storage. If these are set, generated PDFs & uploads go to Supabase Storage
# (required on Render — its disk is ephemeral). If unset, files use local ./uploads.
# Create a bucket (default name "manpowerpay") in the Supabase dashboard first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=manpowerpay
